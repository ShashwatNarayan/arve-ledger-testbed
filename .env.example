# Copy to `.env` and fill in real values for local development.
#
# WARNING: this repository is an intentionally vulnerable security testbed.
# Every credential shipped in it is synthetic. See EXPECTED_FINDINGS.md.

# --- Storage -----------------------------------------------------------------
LEDGER_DATABASE_PATH=./ledger.db
LEDGER_DEFAULT_CURRENCY=USD
LEDGER_MAX_TRANSACTION_MINOR=100000000

# --- Payment provider --------------------------------------------------------
LEDGER_PROVIDER_NAME=acme-payments
LEDGER_WEBHOOK_SIGNING_KEY_PATH=./keys/webhook_signing.pem
PROVIDER_WEBHOOK_SECRET=

# --- Credentials -------------------------------------------------------------
STRIPE_API_KEY=
LEDGER_HMAC_KEY=
JWT_SIGNING_KEY=

# Settlement receipts are emailed from the payments mailbox.
